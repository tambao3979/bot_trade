# Freqtrade environment variable overlay
# Uses FREQTRADE__SECTION__KEY format for nested config
# Double underscore separates hierarchy levels

# API Server
FREQTRADE__api_server__enabled=true
FREQTRADE__api_server__listen_ip_address=127.0.0.1
FREQTRADE__api_server__listen_port=8080
FREQTRADE__api_server__jwt_secret_key=change-me-in-production
FREQTRADE__api_server__ws_token=change-me-in-production

# Exchange credentials (Hyperliquid example)
FREQTRADE__exchange__key=
FREQTRADE__exchange__secret=

# Telegram (optional)
# FREQTRADE__telegram__enabled=false
# FREQTRADE__telegram__token=
# FREQTRADE__telegram__chat_id=

# Dry-run mode (set to false for live trading)
FREQTRADE__dry_run=true

# Database path (optional override)
# FREQTRADE__db_url=sqlite:///tradesv3.dryrun.sqlite
